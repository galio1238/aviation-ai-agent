# Required
ANTHROPIC_API_KEY=your_key_here

# Optional — enables live flight data via OpenSky Network (OAuth2 client credentials)
# Register at https://opensky-network.org to get a client ID and secret
OPENSKY_CLIENT_ID=
OPENSKY_SECRET_KEY=

# Optional — enables airport facility data (runway count, capacity proxy) via OpenAIP
# Register at https://www.openaip.net for a free API key
OPENAIP_KEY=
